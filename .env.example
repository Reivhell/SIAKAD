# Root Environment — only for development convenience
# Backend env vars: see backend/.env.example
# Frontend env vars: see frontend/.env

# Backend (for root dev script convenience)
PORT=3000
NODE_ENV=development
DATABASE_URL="file:./backend/dev.db"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_PASSWORD_SECRET=
COOKIE_SECRET=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend (used by Vite dev server)
VITE_API_URL=http://localhost:3000
