# Backend Environment Variables
PORT=3000
NODE_ENV=development

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# JWT Secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# WAJIB diset eksplisit di production — server menolak start tanpa secret.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_PASSWORD_SECRET=

# Fallback JWT secret (dev only, overridden by specific secrets above)
JWT_SECRET=

# Cookie signing secret
COOKIE_SECRET=

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Password default seeding (HANYA untuk dev/seed). Jangan dipakai di production.
DEFAULT_SEED_PASSWORD=Siakad@2025

# Jumlah proxy hop yang dipercaya untuk membaca IP asli klien (X-Forwarded-For).
# 1 = di belakang satu reverse proxy. 0 = expose langsung (rate limit aman dari spoofing).
TRUST_PROXY=1

# Redis (optional, untuk token blacklist dan caching)
REDIS_URL=